MAP_DATABASE_URL=sqlite:///./data/map.db
# API bind port (use 8001 if 8000 is already in use on the host)
MAP_PORT=8000
MAP_DEBUG=false
MAP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# map-server serves the bundled board from the API origin (same port).
# MAP_SERVE_WEB=false
# MAP_WEB_DIST=/path/to/web/dist

# Fernet key for at-rest encryption of Webhook.secret (alembic 037 + EncryptedString).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAP_WEBHOOK_SECRET_ENCRYPTION_KEY=

# Agent API tokens (for Cursor MCP headers; not used by the MCP Docker service)
MAP_TOKEN_ADMIN=
MAP_TOKEN_AGENT=

# MCP HTTP server (optional; used by map-mcp serve --transport streamable-http)
MAP_MCP_TRANSPORT=streamable-http
MAP_MCP_HOST=0.0.0.0
MAP_MCP_PORT=8080
MAP_MCP_PATH=/mcp
MAP_API_URL=http://localhost:8000
