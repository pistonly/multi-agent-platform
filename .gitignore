web/vite.config.js
web/vite.config.d.ts

# Bundled SPA copied by scripts/sync-web-dist.sh (hashed Vite assets).
# The directory placeholder is tracked; the build output is not.
server/web_dist/**
!server/web_dist/.gitkeep

# T29：wheel 构建时复制的 alembic 树（scripts/prepare-wheel-assets.sh）
server/_migrate/

# Demo project generated output
test_project/output/

# Local scratch (experiment drafts, one-off scripts, notes)
tmp/

# T44：reference/ 为悬空 gitlink 参考材料（无 .gitmodules、本地已空、代码零引用，
# 2026-09-01 按用户决定整体移除；防止再次克隆后被误提交）
reference/

# Local git worktrees (metadata lives in .git/worktrees/)
.worktrees/
.claude/worktrees/
# T31：Claude 巡检运行时状态（历史遗留，已停止）
.claude/topic_watch_state.json

# OS
.DS_Store
Thumbs.db

# Frontend test coverage output (vitest v8)
coverage/

# FS 迁移运行时状态（migration manifest / last-known-good，由 map sync migrate 维护）
map/.fs-migration/
