FROM python:3.12-slim
WORKDIR /app

# Layer 1: install third-party deps (CLI + server + mcp package)
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple --timeout 120 --retries 5 \
    $(python3 -c "import tomllib; d=tomllib.load(open('pyproject.toml','rb')); deps=d['project']['dependencies']+d['project']['optional-dependencies']['server']+['mcp>=1.26.0,<2.0']; print(' '.join(deps))")

# Layer 2: copy application source
COPY server ./server
COPY cli ./cli
COPY sdk ./sdk

RUN pip install --no-cache-dir --no-deps -i https://mirrors.aliyun.com/pypi/simple --timeout 120 --retries 5 ".[mcp]"

EXPOSE 8080
ENV MAP_MCP_TRANSPORT=streamable-http
ENV MAP_MCP_HOST=0.0.0.0
ENV MAP_MCP_PORT=8080
ENV MAP_MCP_PATH=/mcp
ENV MAP_API_URL=http://api:8000
CMD ["map-mcp", "--transport", "streamable-http"]
