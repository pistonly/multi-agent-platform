FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY server ./server
COPY cli ./cli
COPY sdk ./sdk
RUN pip install --no-cache-dir ".[mcp]"
EXPOSE 8080
ENV MAP_MCP_TRANSPORT=streamable-http
ENV MAP_MCP_HOST=0.0.0.0
ENV MAP_MCP_PORT=8080
ENV MAP_MCP_PATH=/mcp
ENV MAP_API_URL=http://api:8000
CMD ["map-mcp", "--transport", "streamable-http"]
