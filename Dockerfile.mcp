FROM python:3.12-slim
WORKDIR /app

# T32：镜像源 ARG 化——默认官方 PyPI；国内构建传
# --build-arg PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
ARG PIP_INDEX_URL=""

# Layer 1: install third-party deps (CLI + mcp package).
# T40: map_mcp import 链零 server 依赖（经 httpx 调远端 API），不再装
# server extra（fastapi/sqlalchemy/alembic 等）——镜像显著减重。
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --timeout 120 --retries 5 ${PIP_INDEX_URL:+-i ${PIP_INDEX_URL}} \
    $(python3 -c "import tomllib; d=tomllib.load(open('pyproject.toml','rb')); deps=d['project']['dependencies']+d['project']['optional-dependencies']['mcp']; print(' '.join(deps))")

# Layer 2: copy application source.
# server/ 源码仍需 COPY：setuptools packages.find 打包 server*（map_mcp
# 不 import 它，仅为 wheel 完整性随包分发）。
COPY server ./server
COPY cli ./cli
COPY sdk ./sdk

RUN pip install --no-cache-dir --no-deps --timeout 120 --retries 5 ${PIP_INDEX_URL:+-i ${PIP_INDEX_URL}} ".[mcp]"

# T32：非 root 运行（mcp 容器无持久写入，统一安全基线）。
ARG UID=1000
ARG GID=1000
RUN groupadd -g "${GID}" map && useradd -u "${UID}" -g "${GID}" -m -s /bin/sh map
USER map

EXPOSE 8080
ENV MAP_MCP_TRANSPORT=streamable-http
ENV MAP_MCP_HOST=0.0.0.0
ENV MAP_MCP_PORT=8080
ENV MAP_MCP_PATH=/mcp
ENV MAP_API_URL=http://api:8000
CMD ["map-mcp", "--transport", "streamable-http"]
